<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight_blue"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header Bar with Back Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/btnBackToLogin"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to Login"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORGOT PASSWORD"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <!-- Logo -->
        <ImageView
            android:src="@drawable/fg_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="FloodGuard Logo"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOODGUARD"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp" />

        <!-- ==================== STEP 1: FIND ACCOUNT ==================== -->
        <LinearLayout
            android:id="@+id/step1Container"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your username or registered Philippine mobile number to receive a secure OTP code."
                android:textColor="@color/light_blue_50"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <!-- Username or Mobile Input -->
            <EditText
                android:id="@+id/identifierField"
                android:hint="Username or Mobile (e.g. 09123456789)"
                android:inputType="text"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Find & Send OTP Button -->
            <Button
                android:id="@+id/btnFindAndSendOtp"
                android:text="SEND VERIFICATION CODE"
                android:backgroundTint="@android:color/white"
                android:textColor="@android:color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />
        </LinearLayout>

        <!-- ==================== STEP 2: VERIFY OTP & RESET PASSWORD ==================== -->
        <LinearLayout
            android:id="@+id/step2Container"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- Banner info -->
            <TextView
                android:id="@+id/tvAccountBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2200E5FF"
                android:padding="12dp"
                android:text="Account found! We sent an OTP verification code to your registered mobile."
                android:textColor="@color/light_blue_200"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="14dp" />

            <!-- OTP Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6-Digit Verification Code"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/otpField"
                android:hint="Enter 6-digit OTP"
                android:inputType="number"
                android:maxLength="6"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:textAlignment="center"
                android:letterSpacing="0.2"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Resend Code -->
            <TextView
                android:id="@+id/btnResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Didn't get code? Resend OTP"
                android:textColor="@color/light_blue_200"
                android:textSize="12sp"
                android:padding="6dp"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- New Password Field with Toggle Eye -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Password"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Must be 6+ chars with uppercase, lowercase, number, and symbol (no spaces)"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/newPasswordField"
                    android:hint="New Password (min 6 chars, A-Z, 0-9, symbol)"
                    android:inputType="textPassword"
                    android:background="@drawable/edittext_bg"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingEnd="46dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/toggleNewPasswordVisibility"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_visibility_off"
                    android:contentDescription="Toggle New Password Visibility"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:padding="2dp"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Confirm New Password Field with Toggle Eye -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm New Password"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/confirmPasswordField"
                    android:hint="Re-type New Password"
                    android:inputType="textPassword"
                    android:background="@drawable/edittext_bg"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingEnd="46dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/toggleConfirmPasswordVisibility"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_visibility_off"
                    android:contentDescription="Toggle Confirm Password Visibility"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:padding="2dp"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnResetPassword"
                android:text="UPDATE PASSWORD"
                android:backgroundTint="@android:color/white"
                android:textColor="@android:color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />
        </LinearLayout>

        <!-- Bottom Return to Sign In -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remembered your password?"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/bottomSignInLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" SIGN IN"
                android:textColor="@android:color/holo_red_light"
                android:textStyle="bold"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
