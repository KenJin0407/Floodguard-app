<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:background="#0A192F"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:layout_alignParentTop="true">

        <!-- Back Button -->
        <LinearLayout
            android:id="@+id/btnHeaderBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="Back"
                android:textColor="#FFA500"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Menu Icon -->
        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/btnHeaderBack"
            android:layout_alignBottom="@id/btnHeaderBack"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:src="@drawable/ic_menu"
            android:contentDescription="Menu" />

        <!-- Screen Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnHeaderBack"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp"
            android:text="Report Flood Level"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Content -->
    <ScrollView
        android:id="@+id/reportScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBar"
        android:fillViewport="true"
        android:isScrollContainer="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="100dp">

            <!-- Live Camera Flood Photo Box Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE FLOOD PHOTO"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="* (CAMERA REQUIRED)"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Camera Capture Box -->
            <FrameLayout
                android:id="@+id/photoPickerBox"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:background="@drawable/dashed_border"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/photoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Captured Photo Preview" />

                <TextView
                    android:id="@+id/tvPhotoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/icon_badge_bg"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="📷 Camera Photo Attached • Tap to Retake"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/photoPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_camera"
                        android:contentDescription="Capture Photo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tap to capture live flood photo"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Live camera photo required (Gallery upload disabled)"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Location Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Location (Device GPS or Select from Dropdown)"
                        android:textColor="#78909C"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnRefreshLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="📍 Auto-Locate"
                        android:textColor="#0066CC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/locationInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:completionThreshold="1"
                        android:dropDownWidth="match_parent"
                        android:dropDownHeight="220dp"
                        android:dropDownVerticalOffset="8dp"
                        android:popupBackground="@drawable/dropdown_menu_bg"
                        android:hint="Detecting device location or type to search..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:inputType="text"
                        android:imeOptions="actionDone" />

                    <TextView
                        android:id="@+id/btnClearLocation"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnLocationDropdown"
                        android:layout_width="30dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="▼"
                        android:textColor="#0A192F"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/locationCoordsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Detecting live device GPS coordinates..."
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Severity Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severity"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Severity 2x2 Grid Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnAnkleDeep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_default"
                        android:text="Ankle-Deep"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnKneeDeep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_default"
                        android:text="Knee-Deep"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnWaistDeep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_selected"
                        android:text="Waist-Deep"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnImpassable"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_default"
                        android:text="Impassable"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Notes Section -->
            <EditText
                android:id="@+id/notesInput"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:gravity="top|start"
                android:hint="Notes (optional) • Karagdagang detalye..."
                android:text="Sasakyan po namin, hindi na kaya tumawid"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="24dp"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                android:inputType="textMultiLine|textCapSentences" />

            <!-- SMS Broadcast Option (Hidden: Handled via In-App Notifications) -->
            <CheckBox
                android:id="@+id/chkSendSmsOnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Broadcast Emergency Alert"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:checked="false"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <!-- Daily Report Limit Indicator -->
            <TextView
                android:id="@+id/tvRemainingReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily Report Limit: 4 / 4 remaining today (Resets daily)"
                android:textColor="#0066CC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/submitReportButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_yellow"
                android:text="SUBMIT REPORT"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Back / Cancel Button -->
            <Button
                android:id="@+id/btnCancelReport"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/btn_severity_default"
                android:text="← BACK / CANCEL"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
