<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0A192F"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_alignParentTop="true">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="#FFA500"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <!-- Screen Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Report Flood Level"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Menu Icon -->
        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_menu"
            android:contentDescription="Menu" />
    </RelativeLayout>

    <!-- Main Content -->
    <com.example.floodguard.InputScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBar"
        android:layout_alignParentBottom="true"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Photo Upload Box -->
            <FrameLayout
                android:id="@+id/photoPickerBox"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/dashed_border"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/photoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Photo Preview" />

                <LinearLayout
                    android:id="@+id/photoPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_add_circle"
                        android:contentDescription="Add Photo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tap to add a photo of the flooded road"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Location Section -->
            <LinearLayout
                android:id="@+id/locationSectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Location (Device GPS or Select from Dropdown)"
                        android:textColor="#78909C"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnRefreshLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="📍 Auto-Locate"
                        android:textColor="#0066CC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/locationInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:completionThreshold="1"
                        android:dropDownWidth="match_parent"
                        android:dropDownVerticalOffset="8dp"
                        android:popupBackground="@drawable/dropdown_menu_bg"
                        android:hint="Detecting device location or type to search..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:inputType="text"
                        android:imeOptions="actionDone" />

                    <TextView
                        android:id="@+id/btnClearLocation"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnLocationDropdown"
                        android:layout_width="30dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="▼"
                        android:textColor="#0A192F"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/locationCoordsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Detecting live device GPS coordinates..."
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Severity Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severity"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Severity 2x2 Grid Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnAnkleDeep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_default"
                        android:text="Ankle-Deep"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnKneeDeep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_default"
                        android:text="Knee-Deep"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnWaistDeep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_selected"
                        android:text="Waist-Deep"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnImpassable"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_severity_default"
                        android:text="Impassable"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Notes Section -->
            <EditText
                android:id="@+id/notesInput"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/search_bg"
                android:padding="12dp"
                android:gravity="top|start"
                android:hint="Notes (optional)"
                android:text="Sasakyan po namin, hindi na kaya tumawid"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="24dp"
                android:inputType="textMultiLine" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submitting this report automatically sends a push alert to FloodGuard users."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

<!-- 24-Hour Flood Danger Radius Notice (English) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E1F5FE"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#0277BD"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Notice" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notice: The flood danger radius displayed on the map automatically expires and disappears after 24 hours. Your submitted report will remain permanently saved in the records."
                    android:textColor="#01579B"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRemainingReports" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Natitirang Report Ngayong Araw: 4 / 4"
                android:textColor="#0277BD"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Buttons Row (Back & Submit) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/backButtonBottom"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_back_blue"
                    android:text="BACK"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/submitReportButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_yellow"
                    android:text="SUBMIT REPORT"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>
    </com.example.floodguard.InputScrollView>

</RelativeLayout>
