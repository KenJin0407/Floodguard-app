<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dropdown_menu_bg"
    android:orientation="vertical">

    <!-- FloodGuard Navy Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_avatar_bg"
            android:padding="9dp"
            android:src="@drawable/ic_phone"
            android:contentDescription="Phone Verification" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify "
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile Number"
                    android:textColor="#FFA500"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Enter the 6-digit security code sent to your phone"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Accent Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FFA500" />

    <!-- Form Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvOtpRecipientPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Verification code sent to 09XXXXXXXXX"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Demo Mode Heads-up Banner (automatically shown if simulated) -->
        <LinearLayout
            android:id="@+id/otpDemoCodeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0F2FE"
            android:padding="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 Demo OTP Code: "
                android:textColor="#0369A1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDemoCodeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123456"
                android:textColor="#0284C7"
                android:textSize="15sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="6-DIGIT VERIFICATION CODE"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtpCodeInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/search_bg"
            android:hint="••••••"
            android:gravity="center"
            android:letterSpacing="0.25"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Timer / Resend Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvOtpTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Code expires in 05:00"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnOtpResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend Code"
                android:textColor="#0284C7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOtpCancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_severity_default"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOtpVerify"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_yellow"
                android:text="Verify &amp; Continue"
                android:textAllCaps="false"
                android:textColor="#0A192F"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
