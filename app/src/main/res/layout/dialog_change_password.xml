<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dropdown_menu_bg"
    android:orientation="vertical">

    <!-- FloodGuard Navy Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_avatar_bg"
            android:padding="9dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Change Password" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change "
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#FFA500"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Secure your FloodGuard account credentials"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Accent Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FFA500" />

    <!-- Form Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="CURRENT PASSWORD"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/dialogCurrentPassInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/search_bg"
                android:hint="Enter current password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="46dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/toggleCurrentPassVisibility"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:contentDescription="Toggle Current Password Visibility"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_visibility_off" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="NEW PASSWORD"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Must be 6+ chars with uppercase, lowercase, number, and symbol (no spaces)"
            android:textColor="#94A3B8"
            android:textSize="10.5sp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/dialogNewPassInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/search_bg"
                android:hint="Min 6 chars (A-Z, a-z, 0-9, symbol)"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="46dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/toggleNewPassVisibility"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:contentDescription="Toggle New Password Visibility"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_visibility_off" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="CONFIRM NEW PASSWORD"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/dialogConfirmPassInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/search_bg"
                android:hint="Re-enter new password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="46dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/toggleConfirmPassVisibility"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:contentDescription="Toggle Confirm Password Visibility"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_visibility_off" />
        </RelativeLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPasswordCancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_severity_default"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPasswordSave"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_yellow"
                android:text="Update Password"
                android:textAllCaps="false"
                android:textColor="#0A192F"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
