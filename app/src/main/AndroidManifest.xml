<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloodGuard">

        <!-- SplashActivity set as launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FloodGuard.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LoginActivity opened after splash -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodGuard"
            android:windowSoftInputMode="adjustResize" />

        <!-- RegisterActivity opened from LoginActivity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodGuard"
            android:windowSoftInputMode="adjustResize" />

        <!-- DashboardActivity opened after login -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodGuard"
            android:windowSoftInputMode="adjustResize" />

        <!-- ReportFloodActivity for submitting flood reports -->
        <activity
            android:name=".ReportFloodActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodGuard"
            android:windowSoftInputMode="adjustResize" />

        <!-- AlertsActivity for viewing flood alerts dashboard -->
        <activity
            android:name=".AlertsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodGuard"
            android:windowSoftInputMode="adjustResize" />

        <!-- ProfileActivity for managing user profile and settings -->
        <activity
            android:name=".ProfileActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodGuard"
            android:windowSoftInputMode="adjustResize" />

        <!-- MapActivity for interactive full-screen map view -->
        <activity
            android:name=".MapActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodGuard"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>
